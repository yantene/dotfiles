#!/bin/bash
# モニタを希望の順序 (左から DP-2 -> HDMI-A-1 -> eDP-1) に並べる。
# 接続されているモニタの実解像度を読んで座標を計算するため、解像度違いの環境にも追従する。

set -eu

ORDER=("DP-2" "HDMI-A-1" "eDP-1")

monitors_json=$(hyprctl monitors -j)

declare -A widths heights scales
present=()
max_h=0
for name in "${ORDER[@]}"; do
  info=$(echo "$monitors_json" | jq -c --arg n "$name" '.[] | select(.name == $n)')
  [[ -z "$info" ]] && continue
  widths[$name]=$(echo "$info" | jq -r '.width')
  heights[$name]=$(echo "$info" | jq -r '.height')
  scales[$name]=$(echo "$info" | jq -r '.scale')
  present+=("$name")
  (( heights[$name] > max_h )) && max_h=${heights[$name]}
done

if (( ${#present[@]} == 0 )); then
  echo "setup-monitors: no target monitors found" >&2
  exit 0
fi

x=0
for name in "${present[@]}"; do
  y=$(( (max_h - heights[$name]) / 2 ))
  hyprctl keyword monitor "$name,preferred,${x}x${y},${scales[$name]}"
  x=$(( x + widths[$name] ))
done
