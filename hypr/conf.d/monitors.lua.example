-- Environment-specific monitor and workspace configuration
-- Copy this file to monitors.lua and customize for your setup.
--
-- See: https://wiki.hypr.land/Configuring/Basics/Monitors/
--      https://wiki.hypr.land/Configuring/Basics/Workspace-Rules/

-- Example: Triple monitor setup
-- hl.monitor({ output = "DP-1", mode = "preferred", position = "-2560x360", scale = 1 })
-- hl.workspace_rule({ workspace = "1", monitor = "DP-1", default = true })
-- hl.workspace_rule({ workspace = "2", monitor = "DP-1" })
-- hl.workspace_rule({ workspace = "3", monitor = "DP-1" })
--
-- hl.monitor({ output = "HDMI-A-1", mode = "preferred", position = "0x0", scale = 1 })
-- hl.workspace_rule({ workspace = "4", monitor = "HDMI-A-1", default = true })
-- hl.workspace_rule({ workspace = "5", monitor = "HDMI-A-1" })
-- hl.workspace_rule({ workspace = "6", monitor = "HDMI-A-1" })
-- hl.workspace_rule({ workspace = "7", monitor = "HDMI-A-1" })
--
-- hl.monitor({ output = "eDP-1", mode = "preferred", position = "3840x0", scale = 1 })
-- hl.workspace_rule({ workspace = "8", monitor = "eDP-1", default = true })
-- hl.workspace_rule({ workspace = "9", monitor = "eDP-1" })
-- hl.workspace_rule({ workspace = "10", monitor = "eDP-1" })
